--!strict

return function()
	local GridMap2D = require(script.Parent.GridMap2D)

	local function makeGrid(): any
		return GridMap2D.new(3, 4, 10, Vector3.new(0, 0, 0))
	end

	describe("new", function()
		it("stores the size it was given", function()
			local grid = makeGrid()
			expect(grid.width).to.equal(3)
			expect(grid.height).to.equal(4)
		end)

		it("starts with empty cells", function()
			local grid = makeGrid()
			expect(grid:GetValue(1, 1)).to.equal(nil)
			expect(grid:IsEmpty(2, 2)).to.equal(true)
		end)

		it("rejects a size of zero", function()
			expect(function()
				GridMap2D.new(0, 4, 10, Vector3.new(0, 0, 0))
			end).to.throw()
		end)
	end)

	describe("bounds", function()
		it("accepts the last column", function()
			local grid = makeGrid()
			expect(grid:SetValue(3, 1, { Name = "edge" })).to.equal(true)
			expect(grid:GetValue(3, 1)).never.to.equal(nil)
		end)

		it("accepts the last row", function()
			local grid = makeGrid()
			expect(grid:SetValue(1, 4, { Name = "edge" })).to.equal(true)
			expect(grid:GetValue(1, 4)).never.to.equal(nil)
		end)

		it("accepts the bottom right corner", function()
			local grid = makeGrid()
			expect(grid:SetValue(3, 4, { Name = "corner" })).to.equal(true)
			expect(grid:GetValue(3, 4)).never.to.equal(nil)
		end)

		it("returns nil one step past the last column", function()
			local grid = makeGrid()
			expect(grid:GetValue(4, 1)).to.equal(nil)
			expect(grid:SetValue(4, 1, {})).to.equal(false)
		end)

		it("returns nil for zero and negative coordinates", function()
			local grid = makeGrid()
			expect(grid:GetValue(0, 1)).to.equal(nil)
			expect(grid:GetValue(1, 0)).to.equal(nil)
			expect(grid:GetValue(-1, -1)).to.equal(nil)
		end)

		it("returns nil for fractional coordinates", function()
			local grid = makeGrid()
			expect(grid:GetValue(1.5, 2)).to.equal(nil)
			expect(grid:GetValue(1, 2.5)).to.equal(nil)
		end)
	end)

	describe("cells", function()
		it("returns the exact table that was stored", function()
			local grid = makeGrid()
			local cell = { ItemID = "1" }
			grid:SetValue(2, 2, cell)
			expect(grid:GetValue(2, 2)).to.equal(cell)
		end)

		it("clears a cell with nil", function()
			local grid = makeGrid()
			grid:SetValue(2, 2, { ItemID = "1" })
			grid:SetValue(2, 2, nil)
			expect(grid:GetValue(2, 2)).to.equal(nil)
		end)

		it("never stores a number as a cell", function()
			local grid = makeGrid()
			grid:SetValue(1, 1, { Position = -50 })
			local cell = grid:GetValue(1, 1)
			expect(typeof(cell)).to.equal("table")
			expect(cell.Position).to.equal(-50)
		end)
	end)

	describe("GetNeighbours", function()
		it("returns no neighbours for an empty grid", function()
			local grid = makeGrid()
			local neighbours = grid:GetNeighbours(2, 2)
			expect(#neighbours).to.equal(0)
		end)

		it("returns only filled side neighbours", function()
			local grid = makeGrid()
			grid:SetValue(3, 2, { Name = "right" })
			grid:SetValue(2, 3, { Name = "up" })
			local neighbours = grid:GetNeighbours(2, 2)
			expect(#neighbours).to.equal(2)
		end)

		it("leaves out diagonal cells", function()
			local grid = makeGrid()
			grid:SetValue(3, 3, { Name = "diagonal" })
			local neighbours = grid:GetNeighbours(2, 2)
			expect(#neighbours).to.equal(0)
		end)

		it("handles a corner cell", function()
			local grid = makeGrid()
			grid:SetValue(2, 1, { Name = "side" })
			local neighbours = grid:GetNeighbours(1, 1)
			expect(#neighbours).to.equal(1)
			expect(neighbours[1][1]).to.equal(2)
			expect(neighbours[1][2]).to.equal(1)
		end)
	end)

	describe("GetXY", function()
		it("round trips a world position", function()
			local grid = makeGrid()
			local world = grid:GetWorldPosition(3, 4)
			local x, y = grid:GetXY(world)
			expect(x).to.equal(3)
			expect(y).to.equal(4)
		end)
	end)
end
